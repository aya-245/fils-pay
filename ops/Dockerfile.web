# Static vite build of apps/web or apps/admin served by nginx.
# docker build -f ops/Dockerfile.web --build-arg APP=web --build-arg API_URL=https://api.example.com .
FROM node:22-bookworm-slim AS build
ARG APP=web
ARG API_URL=http://localhost:3000
ARG WEB_URL=http://localhost:5173
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/events/package.json packages/events/
COPY packages/money/package.json packages/money/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
RUN npm ci
COPY . .
ENV VITE_API_BASE_URL=$API_URL VITE_ADMIN_API_BASE_URL=$API_URL VITE_WEB_BASE_URL=$WEB_URL
RUN npm run build -w apps/$APP

FROM nginxinc/nginx-unprivileged:1.27-alpine
ARG APP=web
COPY --from=build /app/apps/$APP/dist /usr/share/nginx/html
RUN printf 'server {\n listen 8080;\n root /usr/share/nginx/html;\n location / { try_files $uri /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 8080
