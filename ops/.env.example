# FilsPay production env template. Names only — never commit values.
# Fill with: scripts/env-keys.sh build <keys-dir> ops/.env.prod
# Lines marked "# required" must be set for the hosted stack to boot.

NODE_ENV=production                 # required
DATABASE_URL=                       # required (use sslmode=require on a hosted DB)
SETTLEMENT_INTERNAL_TOKEN=          # required, same value for api + settlement
SETTLEMENT_INTERNAL_URL=            # required, e.g. http://settlement:8081
ACQUIRER_CALLBACK_SIGNING_SECRET=   # required
WEBHOOK_SECRET_ENCRYPTION_KEY=      # required, base64 of exactly 32 bytes
CHECKOUT_BASE_URL=                  # required, public URL of apps/web
POSTGRES_PASSWORD=                  # required for ops/docker-compose.prod.yml; must match DATABASE_URL
PUBLIC_API_URL=                     # required for prod web/admin build, e.g. http://<vm-ip>:3000
PUBLIC_WEB_URL=                     # required for prod web/admin build, e.g. https://<WEB_HOST>

# HTTPS overlay (ops/docker-compose.tls.yml) — enabled by deploy-vm.sh when WEB_HOST is set.
# Without a domain use sslip.io names for the server IP, e.g. 168-144-92-39.sslip.io
WEB_HOST=
ADMIN_HOST=
API_HOST=
ACME_EMAIL=
# Bind direct ports to localhost once Caddy fronts them, e.g. 127.0.0.1:3000
API_HOST_PORT=
WEB_HOST_PORT=
ADMIN_HOST_PORT=

# Optional — defaults live in apps/api/src/config.ts and apps/settlement/internal/config
PORT=
PGCONN_SETTLEMENT=
COOKIE_SECURE=
OTP_DEV_EXPOSE=                     # must be false/unset in production
ACQUIRER_CALLBACK_REQUIRE_SIGNATURE=
KYC_UPLOAD_DIR=
VITE_API_BASE_URL=
VITE_ADMIN_API_BASE_URL=
VITE_WEB_BASE_URL=
